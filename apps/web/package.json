{
  "name": "@meshguard/web",
  "version": "0.0.0",
  "private": true,
  "description": "MeshGuard Web Management (React SPA, P4-T01). Hiện chỉ dùng để sinh type TypeScript từ api/openapi.yaml (P2-T02).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../api/openapi.yaml --output src/api/schema.d.ts",
    "spec:json": "node scripts/spec-to-json.mjs"
  },
  "devDependencies": {
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@redocly/openapi-core": "1.34.23",
    "brace-expansion": "2.1.7",
    "uri-js-replace": "1.0.2"
  }
}
