# Tham số của môi trường ci — stack dev/CI của P2-T01a (compose.yaml ở gốc repo, tests/e2e/harness). KHÔNG phải môi
# trường triển khai: chỉ sống trong một lượt chạy trên máy dev/runner CI, mọi kết quả từ đây chỉ được ghi "functional"
# (§22.1). KHÔNG chứa secret (secret sinh mới mỗi lượt, dạng file — tests/e2e/harness/stack.py).
# Ghi đè tạm một biến (chạy song song nhiều stack trên một máy): đặt biến môi trường cùng tên khi chạy harness.
MG_ENV=ci

# Domain thuộc TLD dành riêng .test (RFC 2606): không bao giờ phân giải ngoài stack; client phân giải hostname tenant
# bằng extra_hosts. Chứng chỉ của edge do CA nội bộ sinh mỗi lượt (name constraint chỉ mesh.<domain> này).
MG_BASE_DOMAIN=meshguard-ci.test

# Mạng của stack: hai octet đầu của các network dùng chung (cùng bố cục infrastructure/host/networks.sh — edge .0,
# data .1, admin .2, obs .3, sec .4, egress .5, idp-data .6; mỗi network một /24) và một /28 trong pool tenant
# 10.250.0.0/16 chia đôi thành hai /29 (tenant-a, tenant-b). Edge luôn ở .2 của network edge = IP "điểm vào công
# khai" của stack (derp.server.ipv4, /bootstrap-dns, STUN). Mặc định không chồng mg-* (10.249/16) của host thật,
# stack thử của tests/idp (NET_BASE) và contract test (10.249.254.0/29, 10.250.254.248/29).
MG_E2E_NET_BASE=10.231
MG_E2E_TENANT_NET=10.250.231.0/28

# Edge (render_edge.py): CA ACME và resolver chỉ để qua kiểm tra tham số — stack ci không gọi ACME (TLS từ CA nội bộ)
MG_ACME=staging
MG_DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Nameserver tenant phát cho client: TEST-NET-1 (RFC 5737) — client chạy --accept-dns=false, không dùng tới
MG_TENANT_NAMESERVERS=192.0.2.53

# IdP (P2-T05): identity_providers.id của 3 realm — riêng cho môi trường ci (sinh bằng tools/render_idp.py new-ids)
MG_IDP_ID_PLATFORM=01a1e79d-8050-75aa-be76-96df67793b51
MG_IDP_ID_TENANT_A=01a1e79d-8050-72bd-90db-aa0e6c64ed5a
MG_IDP_ID_TENANT_B=01a1e79d-8050-79d3-a202-045cb5adb611

# Relay thư ra (P3-T05b-mail): Keycloak gửi qua mailrelay:587 (STARTTLS, CA nội bộ do infrastructure/host/mail-secrets.sh
# sinh mỗi lượt); mailrelay chuyển tới Worker GIẢ của stack — mã thật của infrastructure/mail/cf-worker chạy bằng
# devserver (service fakeworker của compose.yaml), http chỉ được phép ở dev/ci. Không bao giờ tới Cloudflare.
MG_IDP_MAIL_SINK=mailrelay
MG_MAILRELAY_URL=http://fakeworker:8787/v1/send
