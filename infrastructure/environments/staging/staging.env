# Tham số của môi trường staging — NGUỒN DUY NHẤT cho IP công khai, domain, địa chỉ LAN/tunnel, tài khoản ACME.
# KHÔNG chứa secret (token, khóa, mật khẩu nằm trong file secret trên host — §14.2).
# Mọi file tham số (*.json), template (nftables) và lệnh trong current.md / RUNBOOK đọc giá trị từ đây qua
# tools/mgenv.py (placeholder ${MG_*}). Luân chuyển (đổi VPS, domain, IP LAN): sửa file này rồi làm theo current.md
# mục "Luân chuyển". Ghi đè tạm một biến: đặt biến môi trường cùng tên khi chạy tool.
MG_ENV=staging

# Domain (D-1) và zone DNS chứa các bản ghi của nền tảng (Cloudflare)
MG_BASE_DOMAIN=gta5web.online
MG_DNS_ZONE=gta5web.online

# Điểm vào công khai = IPv4 của VPS gateway (DNS *.mesh, derp.server.ipv4 của mọi tenant, /bootstrap-dns, l4proxy)
MG_PUBLIC_IPV4=116.118.3.46

# Host staging trong LAN: edge publish 80/443 trên IP này; LAN được tới edge trực tiếp (firewall host, set @lan4)
MG_LAN_IPV4=192.168.1.8
MG_LAN_CIDR=192.168.1.0/24

# Tunnel WireGuard site-to-site host LAN ↔ VPS (P1-T16) và cổng listener tunnel-facing của edge (P1-T17)
MG_TUNNEL_HOST_IPV4=10.248.0.2
MG_TUNNEL_VPS_IPV4=10.248.0.1
MG_TUNNEL_PORT=51820
MG_TUNNEL_HTTP_PORT=8080
MG_TUNNEL_HTTPS_PORT=8443

# ACME (Let's Encrypt) — CA đang dùng và tài khoản được CAA cho phép (P1-T18)
MG_ACME=production
MG_ACME_ACCOUNT_URI=https://acme-v02.api.letsencrypt.org/acme/acct/4006227222

# Resolver công khai cho kiểm tra DNS-01 của edge; nameserver mà các tenant phát cho client
MG_DNS_RESOLVERS=1.1.1.1,8.8.8.8
MG_TENANT_NAMESERVERS=1.1.1.1,1.0.0.1
