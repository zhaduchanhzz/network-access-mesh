#!/usr/sbin/nft -f
# Firewall của host LAN staging (P1-T02, §14.1, V-35, AC-20).
# - Bảng riêng `inet mg_host`, áp cho cả IPv4 và IPv6; không đụng bảng của Docker, không dùng `flush ruleset`.
# - Chiều vào mặc định chặn; chỉ mở SSH từ LAN (IPv4), DHCP và ICMP cần thiết. SSH qua IPv6 bị chặn (V-35).
# - Không cho kết nối mới từ ngoài vào container qua eth0, trừ cổng 80/443 của edge từ LAN (P1-T06); cổng khác
#   của edge (P1-T10, tunnel) được mở bằng rule riêng, sau khi chủ dự án chấp thuận.
# Áp dụng: sudo nft -f mg-staging-firewall.nft     Hoàn tác: sudo nft delete table inet mg_host
table inet mg_host
delete table inet mg_host

table inet mg_host {
    set lan4 {
        type ipv4_addr
        flags interval
        elements = { 192.168.1.0/24 }
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        udp sport 67 udp dport 68 accept                                   # DHCPv4 (gia hạn lease)
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept             # DHCPv6

        ip protocol icmp icmp type { destination-unreachable, time-exceeded } accept
        ip protocol icmp icmp type echo-request ip saddr @lan4 accept
        ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert,
            destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        ip saddr @lan4 tcp dport 22 accept                                 # SSH chỉ từ LAN, chỉ IPv4
        ip saddr @lan4 udp dport 3478 accept                               # stund (Local Development, P1-T06)
        ip saddr 10.248.0.1 icmp type echo-request accept                  # ping từ đầu VPS của tunnel (P1-T16)
    }

    chain forward {
        type filter hook forward priority filter - 1; policy accept;
        # Cổng publish của edge (P1-T06): sau DNAT, đích là IP tĩnh của edge trên mg-edge; chỉ từ LAN, chỉ IPv4.
        iifname "eth0" ip saddr @lan4 ip daddr 10.249.0.2 tcp dport { 80, 443 } ct state new accept
        # Listener tunnel-facing của edge (P1-T16/T17): chỉ đầu VPS của tunnel, chỉ hai cổng; Caddy bắt buộc PROXY v2.
        iifname "mg-wg0" ip saddr 10.248.0.1 ip daddr 10.249.0.2 tcp dport { 8080, 8443 } ct state new accept
        iifname "mg-wg0" ct state new drop                                  # VPS không tới được gì khác
        iifname "eth0" ct state new drop                                    # mọi container khác: không mở từ ngoài
    }
}

# IT-14 (P1-T12c): lọc ở tầng bridge — không cần br_netfilter (module này không được nạp trên host).
# Khung IPv4 xuất phát từ pool tenant chỉ được tới địa chỉ trong pool tenant. Nếu không, container của một tenant có
# NET_ADMIN (lỗi cấu hình capability) tự thêm route qua IP của edge trên network tenant và mở được kết nối tới các IP
# khác của edge (10.249.0.2 site public, 10.249.2.2 admin, 10.249.3.2 metrics) — Linux nhận gói gửi tới mọi IP cục bộ
# trên mọi interface (weak host model). Lưu lượng edge ↔ Headscale (cả hai đầu trong pool) không bị ảnh hưởng.
table bridge mg_bridge
delete table bridge mg_bridge

table bridge mg_bridge {
    chain forward {
        type filter hook forward priority filter; policy accept;
        ether type ip ip saddr 10.250.0.0/16 ip daddr != 10.250.0.0/16 counter drop
    }
}
