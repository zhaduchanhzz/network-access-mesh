# Sinh bởi tools/render_monitoring.py từ infrastructure/monitoring/alertmanager.yml.tmpl (template_version ${template_version}).
# KHÔNG sửa tay — render lại. Alertmanager của project mg-obs (P3-T16; §16.3 của master). Không chứa secret: mật khẩu
# SMTP, token bot Telegram, URL webhook ngoài là file secret root:mg-sec-obs 0440 (/opt/meshguard/secrets/obs/,
# infrastructure/host/obs-secrets.sh) mount vào /run/secrets/ — config chỉ trỏ tới đường dẫn (*_file).
#
# Kênh của môi trường này: ${channels}
# Bật kênh khác: điền MG_ALERT_* trong file tham số môi trường, nạp secret bằng obs-secrets.sh, render lại, rồi
# `docker compose -p mg-obs -f compose.monitoring.yaml up -d alertmanager` (RUNBOOK mục P3-T16).
global:
  resolve_timeout: 5m

route:
  receiver: meshguard
  group_by: [alertname, job, via, target, mountpoint]
  group_wait: ${group_wait}
  group_interval: ${group_interval}
  repeat_interval: ${repeat_interval}

# §16.3: trong cửa sổ boot của host (HostRebooted — node_boot_time_seconds), "instance down"/probe fail theo tenant được
# nén vào một cảnh báo "host vừa khởi động lại"; hết cửa sổ mà instance chưa lên thì cảnh báo như thường. Chuỗi diễn tập
# (nhãn drill="1") không bao giờ nén cảnh báo thật.
inhibit_rules:
  - source_matchers: [alertname="HostRebooted", drill!="1"]
    target_matchers: [alertname=~"TenantInstanceDown|TenantControlProbeFailed"]

receivers:
  - name: meshguard
${receiver_configs}
