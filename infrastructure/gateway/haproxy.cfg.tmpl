# Sinh bởi tools/render_gateway.py từ infrastructure/gateway/haproxy.cfg.tmpl (template_version ${template_version}).
# KHÔNG sửa tay — render lại. l4proxy của VPS Public Gateway (§14.9): chỉ chuyển tiếp TCP, không terminate TLS, không
# có chứng chỉ; gửi PROXY v2 tới listener tunnel-facing của edge qua tunnel WireGuard (GW-03).
global
    log stdout format raw local0 info
    maxconn 20000
    user haproxy
    group haproxy

defaults
    mode tcp
    log global
    option tcplog
    option dontlognull
    timeout connect 5s
    # stream control (long-poll Noise) và DERP sống lâu, nhàn rỗi tới vài phút giữa các keepalive (V-18)
    timeout client 2h
    timeout server 2h
    timeout client-fin 30s
    timeout server-fin 30s
    # F-G3-1 (G3, 2026-11-18): sau khi edge bị thay (recreate/reboot) một phiên long-poll qua VPS treo nửa vời ~7 phút —
    # timeout 2h và không keepalive nên HAProxy không thấy. TCP keepalive hai phía phát hiện kết nối chết trong ~60 s
    # (30 s nhàn rỗi + 3 × 10 s), độc lập với keepalive ứng dụng của long-poll (V-18: các stream vẫn sống 2h).
    option tcpka
    clitcpka-idle 30s
    clitcpka-intvl 10s
    clitcpka-cnt 3
    srvtcpka-idle 30s
    srvtcpka-intvl 10s
    srvtcpka-cnt 3
    # kiểm sức khỏe edge mỗi 2 s qua tunnel (kèm PROXY v2 như lưu lượng thật — listener tunnel-facing đòi header);
    # edge vắng ⇒ đánh dấu down sau 2 lần ⇒ đóng mọi phiên đang mở để client nối lại ngay khi edge lên (rise 2)
    default-server check inter 2s fall 2 rise 2 check-send-proxy on-marked-down shutdown-sessions

frontend https_in
    bind ${vps_public_ipv4}:443
    default_backend edge_https

frontend http_in
    bind ${vps_public_ipv4}:80
    default_backend edge_http

backend edge_https
    server edge ${edge_tunnel_ipv4}:${https_port} send-proxy-v2

backend edge_http
    server edge ${edge_tunnel_ipv4}:${http_port} send-proxy-v2
