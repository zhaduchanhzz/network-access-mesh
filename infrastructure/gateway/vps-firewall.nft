#!/usr/sbin/nft -f
# Firewall của VPS Public Gateway (P1-T15, §14.9, §15.1). Bảng riêng `inet mg_vps`; không đụng bảng của Docker.
# Chiều vào mặc định chặn. Mở: SSH (chỉ key — sshd_config.d/00-meshguard.conf), TCP 80/443 (l4proxy), UDP 3478
# (stund), UDP 51820 (tunnel WireGuard — host LAN chủ động kết nối), TCP 25/587 (dịch vụ thư sẵn có của chủ dự án).
# Không publish cổng container nào từ Internet (các dự án cũ đã dừng). VPS không có IPv6 công khai (A.4).
# Áp dụng: bash apply-vps-firewall.sh < vps-firewall.nft     Hoàn tác: sudo nft delete table inet mg_vps
table inet mg_vps
delete table inet mg_vps

table inet mg_vps {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        udp sport 67 udp dport 68 accept                                   # DHCPv4 (nếu nhà cung cấp dùng DHCP)
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, echo-request } limit rate 20/second accept
        ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert,
            destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        tcp dport 22 accept                                                # SSH — chỉ khóa (giới hạn IP nguồn: xem P1-T15)
        tcp dport { 80, 443 } accept                                       # l4proxy → tunnel → edge
        udp dport 3478 accept                                              # stund dùng chung (GW-01)
        udp dport 51820 accept                                             # WireGuard site-to-site (P1-T16)
        tcp dport { 25, 587 } accept                                       # postfix của chủ dự án (có sẵn trước MeshGuard)
    }

    chain forward {
        type filter hook forward priority filter - 1; policy accept;
        iifname "eth0" ct state new drop                                    # không mở container nào từ Internet
    }
}
