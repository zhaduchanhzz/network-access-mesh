# Caddy của image web (P4-T01): phục vụ SPA tĩnh /srv/web trên :8080 (HTTP thường — TLS kết thúc ở edge, §14.6).
# Không admin API, không TLS, không ghi cấu hình; chỉ module chuẩn. Một bản build cho app.<domain> và admin.<domain>.
{
	admin off
	persist_config off
	auto_https off
	servers {
		protocols h1
	}
	log {
		output stdout
		format json
		level WARN
	}
}

:8080 {
	root * /srv/web

	# Header bảo mật trình duyệt (CSP, HSTS, nosniff, X-Frame-Options, Referrer-Policy, COOP/CORP, Permissions-Policy)
	# KHÔNG đặt ở đây: edge là nguồn duy nhất cho mọi phản hồi của app./admin. — api, SPA và trang lỗi của edge
	# (portal_headers + platform_headers của infrastructure/caddy/Caddyfile.tmpl, P4-T01a; test src/security/csp.test.ts).
	# Container chỉ trên mg-edge, không bao giờ được phục vụ trực tiếp. Ở đây chỉ còn header theo nội dung (Cache-Control)
	# và không lộ Server.
	header -Server

	@api path /api /api/*
	# path thô (đã giải mã, chưa làm sạch): dotfile, "/./", "/../" (kể cả %2e/%2f) — matcher `path` so path đã làm sạch
	@hidden vars_regexp hidden {http.request.uri.path} (^|/)\.
	@unsafe path_regexp unsafe \x5c
	route {
		# API không bao giờ do container này trả lời — edge định tuyến /api/* tới api
		respond @api 404
		respond @hidden 404
		respond @unsafe 404
		# asset có hash nội dung trong tên: cache lâu; thiếu file ⇒ 404 (không trả index.html thay cho JS/CSS)
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# mọi đường dẫn khác: file nếu có (favicon), nếu không là index.html — router của SPA quyết định (404 thống nhất)
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
