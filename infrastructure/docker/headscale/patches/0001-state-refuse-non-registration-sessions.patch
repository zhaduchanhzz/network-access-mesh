diff --git a/hscontrol/grpcv1.go b/hscontrol/grpcv1.go
index a1d349a..1db6c29 100644
--- a/hscontrol/grpcv1.go
+++ b/hscontrol/grpcv1.go
@@ -269,6 +269,13 @@ func (api headscaleV1APIServer) RegisterNode(
 			Str(zf.RegistrationKey, registrationKey).
 			Err(err).
 			Msg("failed to register node")
+
+		// The auth ID names a session of another kind (e.g. an SSH check):
+		// a client error, answered by grpc-gateway with HTTP 400.
+		if errors.Is(err, state.ErrAuthRequestNotRegistration) {
+			return nil, status.Error(codes.InvalidArgument, err.Error())
+		}
+
 		return nil, err
 	}
 
diff --git a/hscontrol/grpcv1_auth_session_test.go b/hscontrol/grpcv1_auth_session_test.go
new file mode 100644
index 0000000..20d26b4
--- /dev/null
+++ b/hscontrol/grpcv1_auth_session_test.go
@@ -0,0 +1,207 @@
+package hscontrol
+
+// MeshGuard patch 0001 (V-26) — remove together with the patch.
+//
+// Registering a node with the auth ID of a pending session that is not a node
+// registration (an SSH check-mode session) must be refused as a client error.
+// Before, [types.AuthRequest.RegistrationData] panicked inside the gRPC handler
+// and, with no recovery on the gRPC servers, terminated the whole process.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	grpcRuntime "github.com/grpc-ecosystem/grpc-gateway/v2/runtime"
+	v1 "github.com/juanfont/headscale/gen/go/headscale/v1"
+	"github.com/juanfont/headscale/hscontrol/state"
+	"github.com/juanfont/headscale/hscontrol/types"
+	"github.com/juanfont/headscale/hscontrol/util"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/status"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/key"
+)
+
+func TestAuthRegisterRefusesNonRegistrationSession(t *testing.T) {
+	app := createTestApp(t)
+	t.Cleanup(func() { _ = app.state.Close() })
+
+	api := newHeadscaleV1APIServer(app)
+	user := app.state.CreateUserForTest("auth-session-user")
+
+	sessions := []struct {
+		name string
+		new  func() *types.AuthRequest
+	}{
+		{"ssh check", func() *types.AuthRequest { return types.NewSSHCheckAuthRequest(1, 2) }},
+		{"verdict only", types.NewAuthRequest},
+	}
+	for _, tc := range sessions {
+		t.Run(tc.name, func(t *testing.T) {
+			id := types.MustAuthID()
+			session := tc.new()
+			require.NoError(t, app.state.SetAuthCacheEntry(id, session))
+
+			var err error
+
+			require.NotPanics(t, func() {
+				_, _, err = app.state.HandleNodeFromAuthPath(id, types.UserID(user.ID), nil, util.RegisterMethodCLI)
+			})
+			require.ErrorIs(t, err, state.ErrAuthRequestNotRegistration)
+
+			require.NotPanics(t, func() {
+				_, err = api.AuthRegister(context.Background(), &v1.AuthRegisterRequest{AuthId: id.String(), User: user.Name})
+			})
+
+			st, ok := status.FromError(err)
+			require.True(t, ok, "AuthRegister must answer with a gRPC status, got %v", err)
+			assert.Equal(t, codes.InvalidArgument, st.Code())
+			assert.Equal(t, state.ErrAuthRequestNotRegistration.Error(), st.Message())
+			assert.NotContains(t, st.Message(), id.String(), "the answer must not echo the auth ID")
+			assert.Equal(t, http.StatusBadRequest, grpcRuntime.HTTPStatusFromCode(st.Code()))
+
+			require.NotPanics(t, func() {
+				_, err = api.RegisterNode(context.Background(), &v1.RegisterNodeRequest{Key: id.String(), User: user.Name})
+			})
+			assert.Equal(t, codes.InvalidArgument, status.Code(err))
+
+			// Nothing was registered and the session is left to the flow that owns it.
+			assert.Equal(t, 0, app.state.ListNodes().Len())
+
+			got, ok := app.state.GetAuthCacheEntry(id)
+			require.True(t, ok, "the session must stay pending")
+			require.Same(t, session, got)
+			require.False(t, got.IsFinished())
+		})
+	}
+}
+
+func TestAuthRegisterLeavesSSHCheckSessionResolvable(t *testing.T) {
+	app := createTestApp(t)
+	t.Cleanup(func() { _ = app.state.Close() })
+
+	api := newHeadscaleV1APIServer(app)
+	user := app.state.CreateUserForTest("ssh-check-user")
+
+	for _, approve := range []bool{true, false} {
+		id := types.MustAuthID()
+		session := types.NewSSHCheckAuthRequest(1, 2)
+		require.NoError(t, app.state.SetAuthCacheEntry(id, session))
+
+		_, err := api.AuthRegister(context.Background(), &v1.AuthRegisterRequest{AuthId: id.String(), User: user.Name})
+		require.Equal(t, codes.InvalidArgument, status.Code(err))
+
+		if approve {
+			_, err = api.AuthApprove(context.Background(), &v1.AuthApproveRequest{AuthId: id.String()})
+		} else {
+			_, err = api.AuthReject(context.Background(), &v1.AuthRejectRequest{AuthId: id.String()})
+		}
+		require.NoError(t, err)
+
+		select {
+		case verdict := <-session.WaitForAuth():
+			assert.Equal(t, approve, verdict.Accept())
+		case <-time.After(5 * time.Second):
+			t.Fatal("the SSH check session was not resolved")
+		}
+	}
+
+	assert.Equal(t, 0, app.state.ListNodes().Len())
+}
+
+func TestAuthRegisterRegistrationSessionStillRegisters(t *testing.T) {
+	app := createTestApp(t)
+	t.Cleanup(func() { _ = app.state.Close() })
+
+	api := newHeadscaleV1APIServer(app)
+	user := app.state.CreateUserForTest("registration-user")
+
+	id := types.MustAuthID()
+	require.NoError(t, app.state.SetAuthCacheEntry(id, types.NewRegisterAuthRequest(&types.RegistrationData{
+		MachineKey: key.NewMachine().Public(),
+		NodeKey:    key.NewNode().Public(),
+		Hostname:   "registration-node",
+		Hostinfo:   &tailcfg.Hostinfo{Hostname: "registration-node"},
+	})))
+
+	resp, err := api.AuthRegister(context.Background(), &v1.AuthRegisterRequest{AuthId: id.String(), User: user.Name})
+	require.NoError(t, err)
+	assert.Equal(t, "registration-node", resp.GetNode().GetName())
+	assert.Equal(t, user.Name, resp.GetNode().GetUser().GetName())
+	assert.Equal(t, v1.RegisterMethod_REGISTER_METHOD_CLI, resp.GetNode().GetRegisterMethod())
+	assert.Equal(t, 1, app.state.ListNodes().Len())
+
+	_, ok := app.state.GetAuthCacheEntry(id)
+	assert.False(t, ok, "a completed registration leaves the auth cache")
+}
+
+func TestAuthRegisterNonRegistrationSessionOverGateway(t *testing.T) {
+	app := createTestApp(t)
+	t.Cleanup(func() { _ = app.state.Close() })
+
+	user := app.state.CreateUserForTest("gateway-user")
+	id := types.MustAuthID()
+	require.NoError(t, app.state.SetAuthCacheEntry(id, types.NewSSHCheckAuthRequest(1, 2)))
+
+	gateway := authSessionTestGateway(t, newHeadscaleV1APIServer(app))
+	body := fmt.Sprintf(`{"user":%q,"authId":%q}`, user.Name, id.String())
+	rec := httptest.NewRecorder()
+	gateway.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/api/v1/auth/register", strings.NewReader(body)))
+
+	require.Equal(t, http.StatusBadRequest, rec.Code, rec.Body.String())
+
+	var answer struct {
+		Code    int    `json:"code"`
+		Message string `json:"message"`
+	}
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &answer))
+	assert.Equal(t, int(codes.InvalidArgument), answer.Code)
+	assert.Equal(t, state.ErrAuthRequestNotRegistration.Error(), answer.Message)
+
+	_, ok := app.state.GetAuthCacheEntry(id)
+	assert.True(t, ok, "the SSH check session must stay pending")
+}
+
+// authSessionTestGateway serves api on a gRPC server listening on a unix
+// socket, as the local server behind the REST gateway does, and returns the
+// REST gateway in front of it.
+func authSessionTestGateway(t *testing.T, api v1.HeadscaleServiceServer) http.Handler {
+	t.Helper()
+
+	dir, err := os.MkdirTemp("", "hsgw")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+
+	socket := filepath.Join(dir, "grpc.sock")
+	listener, err := new(net.ListenConfig).Listen(context.Background(), "unix", socket)
+	require.NoError(t, err)
+
+	server := grpc.NewServer()
+	v1.RegisterHeadscaleServiceServer(server, api)
+
+	go func() { _ = server.Serve(listener) }()
+
+	t.Cleanup(server.Stop)
+
+	conn, err := grpc.NewClient("unix://"+socket, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+
+	mux := grpcRuntime.NewServeMux()
+	require.NoError(t, v1.RegisterHeadscaleServiceHandler(context.Background(), mux, conn))
+
+	return mux
+}
