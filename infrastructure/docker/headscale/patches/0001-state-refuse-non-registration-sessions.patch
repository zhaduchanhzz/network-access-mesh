+++ b/hscontrol/state/state.go
@@ -130,6 +130,11 @@ var ErrAuthCacheClosed = errors.New("authentication cache closed")
 // ErrAuthRequestFinished prevents reusing an already resolved verdict channel.
 var ErrAuthRequestFinished = errors.New("authentication request already finished")
 
+// ErrAuthRequestNotRegistration is returned when a node registration names a
+// pending authentication that is not a node registration, for example an SSH
+// check-mode session. Such a session carries no [types.RegistrationData].
+var ErrAuthRequestNotRegistration = errors.New("auth session is not for node registration")
+
 // ErrNodeKeyInUse is returned when a registration or re-auth claims a NodeKey
 // already bound to a different machine, enforcing the 1:1 NodeKey<->MachineKey
 // binding.
@@ -2397,6 +2402,13 @@ func (s *State) HandleNodeFromAuthPath(
 		return types.NodeView{}, change.Change{}, hsdb.ErrNodeNotFoundRegistrationCache
 	}
 
+	// Registrations and SSH check-mode sessions share the auth cache. Refuse
+	// any other kind of session before [types.AuthRequest.RegistrationData]
+	// panics on it, and leave that session to the flow that owns it.
+	if !regEntry.IsRegistration() {
+		return types.NodeView{}, change.Change{}, ErrAuthRequestNotRegistration
+	}
+
 	// Get the user
 	user, err := s.db.GetUserByID(userID)
 	if err != nil {
