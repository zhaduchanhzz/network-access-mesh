# Sinh bởi tools/render_edge.py từ infrastructure/caddy/Caddyfile.tmpl (template_version ${template_version}).
# KHÔNG sửa tay — render lại. Edge của MeshGuard (§14.6): mesh domain ${mesh_domain}, CA ${acme}.
# - Site public chỉ bind IP tĩnh của edge trên mg-edge (${edge_ip}); cổng publish của host DNAT tới IP này (V-30).
# - Không có giá trị secret nào trong file: token DNS và khóa bouncer chỉ được tham chiếu bằng placeholder {file.*},
#   Caddy đọc file lúc provision (secret dạng file — §14.2).
# - Listener admin (mg-admin) và metrics (mg-obs) được thêm ở P1-T10; CrowdSec ở chế độ chỉ-quan-sát tới G1
#   (app crowdsec kết nối LAPI nhưng chưa route nào dùng handler crowdsec).
{
	admin unix//run/caddy/admin.sock
	persist_config off
	default_bind ${edge_ip}
	auto_https disable_redirects
	acme_ca ${acme_ca}
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format json
		level INFO
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {file./run/secrets/bouncer_key}
		ticker_interval 15s
	}
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			mode 0640
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

# Control plane + DERP của mọi tenant: <slug>.${mesh_domain} → hs-<slug>:8080 trên network riêng của tenant.
*.${mesh_domain} {
	import access_log
	tls {
		dns cloudflare {file./run/secrets/cloudflare_dns_token}
		resolvers ${dns_resolvers}
	}

	# Nhãn tenant = capture group của regex slug neo vào hậu tố .${mesh_domain} (không dùng {labels.N} — EG-03).
	# Allow-list path (§14.6); mọi path khác — gồm /api/*, /swagger*, /verify, /version, /health, /metrics — là 404.
	@tenant {
		vars_regexp tenant {http.request.host} ^([a-z][a-z0-9-]{1,30}[a-z0-9])\.${mesh_domain_re}$$
		path /ts2021 /key /machine/ping-response /derp /derp/* /bootstrap-dns /register/* /auth/* /oidc/callback
	}
	handle @tenant {
		reverse_proxy hs-{re.tenant.1}.:8080 {
			header_up True-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			stream_close_delay 5m
		}
	}
	handle {
		respond 404
	}
	# Tenant không tồn tại / đang dừng / chưa gắn edge là lỗi dial ⇒ cùng một 404 như path bị chặn (§14.6).
	handle_errors 502 503 504 {
		respond 404
	}
}

# :80 — /generate_204 trả 204 (kiểm captive portal của client; vang lại challenge như derper), còn lại chuyển
# HTTPS bằng phản hồi nhanh khác 101 (EG-07).
http:// {
	import access_log
	@gen204 path /generate_204
	@challenge header_regexp X-Tailscale-Challenge ^[A-Za-z0-9._-]{1,64}$$
	handle @gen204 {
		header @challenge X-Tailscale-Response "response {http.request.header.X-Tailscale-Challenge}"
		header Cache-Control "no-cache, no-store, must-revalidate, no-transform, max-age=0"
		respond 204
	}
	handle {
		redir https://{host}{uri} 308
	}
}
