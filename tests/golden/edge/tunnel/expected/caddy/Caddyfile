# Sinh bởi tools/render_edge.py từ infrastructure/caddy/Caddyfile.tmpl (template_version 6).
# KHÔNG sửa tay — render lại. Edge của MeshGuard (§14.6): mesh domain mesh.example.com, CA staging.
# - Site public chỉ bind IP tĩnh của edge trên mg-edge (10.249.0.2); cổng publish của host DNAT tới IP này (V-30).
# - Listener nội bộ: admin trên mg-admin (10.249.2.2:8081), metrics trên mg-obs (10.249.3.2:9091).
# - Listener tunnel-facing (VPS gateway — §14.6, GW-02): 10.249.0.2:8443 (TLS) và :8080, publish trên IP tunnel 10.248.0.2; bắt buộc PROXY v2 từ 10.248.0.1, header từ nguồn khác bị từ chối, kết nối không header từ nguồn khác bị đóng ở tầng HTTP (@direct_tunnel)
# - Site của nền tảng (P2-T16, §8.3, §15.4): app.example.com (LAN-direct + tunnel-facing) → api, auth.example.com
#   (LAN-direct + tunnel-facing) → idp, admin.example.com CHỈ LAN-direct (không bao giờ trên listener tunnel-facing)
#   và chỉ từ 192.0.2.0/24. Admin REST API và realm master của Keycloak chỉ từ worker (10.249.0.4) trên
#   listener LAN-direct.
# - Không có giá trị secret nào trong file: token DNS, khóa bouncer, token admin/metrics chỉ được tham chiếu bằng
#   placeholder {file.*}, Caddy đọc file lúc provision hoặc lúc so khớp (secret dạng file — §14.2).
# - CrowdSec ở chế độ chỉ-quan-sát (app crowdsec kết nối LAPI, chưa route nào dùng handler crowdsec; mọi site public
#   ghi cùng access log mà CrowdSec đọc) — bật chặn là quyết định riêng (P6-T07b).
{
	admin unix//run/caddy/admin.sock
	persist_config off
	default_bind 10.249.0.2
	auto_https disable_redirects
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	servers 10.249.0.2:8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				deny 0.0.0.0/5 8.0.0.0/7 10.0.0.0/9 10.128.0.0/10 10.192.0.0/11 10.224.0.0/12 10.240.0.0/13 10.248.0.0/32 10.248.0.2/31 10.248.0.4/30 10.248.0.8/29 10.248.0.16/28 10.248.0.32/27 10.248.0.64/26 10.248.0.128/25 10.248.1.0/24 10.248.2.0/23 10.248.4.0/22 10.248.8.0/21 10.248.16.0/20 10.248.32.0/19 10.248.64.0/18 10.248.128.0/17 10.249.0.0/16 10.250.0.0/15 10.252.0.0/14 11.0.0.0/8 12.0.0.0/6 16.0.0.0/4 32.0.0.0/3 64.0.0.0/2 128.0.0.0/1 ::/0
				fallback_policy require
			}
			tls
		}
		protocols h1 h2
		strict_sni_host on
	}
	servers 10.249.0.2:8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				deny 0.0.0.0/5 8.0.0.0/7 10.0.0.0/9 10.128.0.0/10 10.192.0.0/11 10.224.0.0/12 10.240.0.0/13 10.248.0.0/32 10.248.0.2/31 10.248.0.4/30 10.248.0.8/29 10.248.0.16/28 10.248.0.32/27 10.248.0.64/26 10.248.0.128/25 10.248.1.0/24 10.248.2.0/23 10.248.4.0/22 10.248.8.0/21 10.248.16.0/20 10.248.32.0/19 10.248.64.0/18 10.248.128.0/17 10.249.0.0/16 10.250.0.0/15 10.252.0.0/14 11.0.0.0/8 12.0.0.0/6 16.0.0.0/4 32.0.0.0/3 64.0.0.0/2 128.0.0.0/1 ::/0
				fallback_policy require
			}
		}
		protocols h1 h2
	}
	servers {
		protocols h1 h2
		strict_sni_host on
	}
	log {
		output stdout
		format json
		level INFO
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {file./run/secrets/bouncer_key}
		ticker_interval 15s
	}
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			mode 0640
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

# Log của listener nội bộ: tách khỏi access log mà CrowdSec đọc; xóa header mang token (Caddy chỉ tự che
# Authorization/Cookie, KHÔNG che X-MG-Token).
(internal_log) {
	log {
		output file /var/log/caddy/internal.log {
			mode 0640
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			request>headers>X-Mg-Token delete
			request>headers>Authorization delete
		}
	}
}

# Chứng chỉ công khai qua ACME DNS-01 (không cần inbound — §15.4): wildcard *.mesh.example.com và app./admin./auth.
(tls_acme) {
	tls {
		dns cloudflare {file./run/secrets/cloudflare_dns_token}
		resolvers 1.1.1.1 8.8.8.8
	}
}

# Site của nền tảng (app., admin., auth. — P2-T16): nguồn thuộc pool tenant (container Headscale không bao giờ gọi
# edge — §14.3 kiểm soát (3)) và path có "\" bị chặn trước mọi route; HSTS, nosniff; không lộ header Server.
(platform_site) {
	@from_tenant_pool remote_ip 10.250.0.0/16
	@unsafe_path path_regexp unsafe \x5c
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
		defer
	}
}

# Portal/Console (app., admin.): trang và API cùng origin, không nhúng frame, không referrer.
(portal_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		defer
	}
}

# Header gửi lên upstream của nền tảng: Host giữ nguyên (api chọn origin theo Host; Keycloak theo X-Forwarded-Host),
# X-Forwarded-For/-Proto/-Host do edge đặt (client không phải trusted proxy ⇒ Caddy ghi đè), header nội bộ X-MG-* và
# header IP do client tự gửi không bao giờ đi tiếp.
(upstream_headers) {
	header_up -X-MG-Token
	header_up -X-MG-Instance
	header_up -X-Mg-*
	header_up -X-Real-IP
	header_up -True-Client-IP
	header_up -Forwarded
}

# Control plane + DERP của mọi tenant: <slug>.mesh.example.com → hs-<slug>:8080 trên network riêng của tenant.
*.mesh.example.com, *.mesh.example.com:8443 {
	import access_log
	# Vào thẳng listener tunnel-facing mà không qua PROXY header của VPS (địa chỉ đích còn là cổng tunnel)
	# ⇒ đóng kết nối, trước mọi handle khác (proxy_protocol chỉ REJECT nguồn bị deny khi chúng GỬI header).
	@direct_tunnel vars {http.request.local.port} 8443 8080
	handle @direct_tunnel {
		abort
	}
	import tls_acme

	# Nhãn tenant = capture group của regex slug neo vào hậu tố .mesh.example.com (không dùng {labels.N} — EG-03).
	# Allow-list path (§14.6); mọi path khác — gồm /api/*, /swagger*, /verify, /version, /health, /metrics — là 404.
	@tenant {
		vars_regexp tenant {http.request.host} ^([a-z][a-z0-9-]{1,30}[a-z0-9])\.mesh\.example\.com$
		path /ts2021 /key /machine/ping-response /derp /derp/* /register/* /auth/* /oidc/callback
	}
	# /bootstrap-dns KHÔNG proxy (RT-15: không xác thực, Headscale tra DNS phía server từ network internal):
	# trả tĩnh tên tenant → IP điểm vào công khai (V-32). Ngoặc nhọn của JSON được escape cho bộ thay placeholder.
	@bootstrap_dns {
		vars_regexp bootstrap {http.request.host} ^([a-z][a-z0-9-]{1,30}[a-z0-9])\.mesh\.example\.com$
		path /bootstrap-dns
	}
	@unsafe_path path_regexp unsafe \x5c
	handle @bootstrap_dns {
		header Content-Type application/json
		header Cache-Control "no-store"
		respond `\{"{http.request.host}":["198.51.100.7"]\}` 200
	}
	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}
	# Path có "\" (kể cả dạng %5c) không bao giờ được proxy: matcher của Caddy so path đã giải mã và đã làm sạch
	# ("/./", "/../", "//" — caddyserver/caddy#4407) nhưng không coi "\" là dấu phân cách (P1-T10a).
	handle @unsafe_path {
		respond 404
	}
	handle @tenant {
		reverse_proxy hs-{re.tenant.1}.:8080 {
			header_up True-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			stream_close_delay 5m
		}
	}
	handle {
		respond 404
	}
	# Tenant không tồn tại / đang dừng / chưa gắn edge là lỗi dial ⇒ cùng một 404 như path bị chặn (§14.6).
	handle_errors 502 503 504 {
		respond 404
	}
}

# Tenant Portal + SaaS API (§8.3, §15.1): app.example.com — LAN-direct và tunnel-facing (public qua VPS). /api/* →
# api:8080 trên mg-edge (api chỉ nhận request từ IP của edge — MG_TRUSTED_PROXIES); path khác ⇒ 404 tới khi có web UI
# (Phase 4). Thứ tự xử lý tường minh trong `route` (không phụ thuộc cách Caddy sắp các `handle`).
app.example.com, app.example.com:8443 {
	import access_log
	import tls_acme
	import platform_site
	import portal_headers
	@direct_tunnel vars {http.request.local.port} 8443 8080
	route {
		abort @direct_tunnel
		abort @from_tenant_pool
		respond @unsafe_path 404
		reverse_proxy /api/* api.:8080 {
			import upstream_headers
		}
		respond 404
	}
}

# Platform Console (§8.3, §15.1): admin.example.com — CHỈ listener LAN-direct (site này không có địa chỉ
# tunnel-facing nên không tồn tại trên server của listener đó) và chỉ từ 192.0.2.0/24; nguồn khác ⇒ đóng kết nối.
# DNS công khai không có bản ghi admin (§15.4).
admin.example.com {
	import access_log
	import tls_acme
	import platform_site
	import portal_headers
	@outside_admin not remote_ip 192.0.2.0/24
	route {
		abort @from_tenant_pool
		abort @outside_admin
		respond @unsafe_path 404
		reverse_proxy /api/* api.:8080 {
			import upstream_headers
		}
		respond 404
	}
}

# IdP của nền tảng (§8.2): auth.example.com → idp:8080 (Keycloak; cổng quản trị 9000 không bao giờ được định tuyến).
# Công khai chỉ endpoint OIDC + trang đăng nhập của các realm (/realms/*, /resources/*), TRỪ realm master. Admin REST
# API (/admin/realms/*) và realm master (token của danh tính provisioning, break-glass) CHỈ từ worker
# (10.249.0.4 — IdP driver, P2-T05a) và chỉ trên listener LAN-direct này; console /admin/ không bao giờ.
auth.example.com {
	import access_log
	import tls_acme
	import platform_site
	@idp_worker {
		remote_ip 10.249.0.4
		path /admin/realms /admin/realms/* /realms/master /realms/master/*
	}
	@idp_public {
		path /realms/* /resources/*
		not path /realms/master /realms/master/*
	}
	route {
		abort @from_tenant_pool
		respond @unsafe_path 404
		reverse_proxy @idp_worker idp.:8080 {
			import upstream_headers
		}
		reverse_proxy @idp_public idp.:8080 {
			import upstream_headers
		}
		respond 404
	}
}

# auth.example.com trên listener tunnel-facing (public qua VPS): chỉ endpoint OIDC và trang đăng nhập
# công khai của các realm (trừ master). Admin REST API, realm master và console KHÔNG tồn tại trên server này.
auth.example.com:8443 {
	import access_log
	@direct_tunnel vars {http.request.local.port} 8443 8080
	import tls_acme
	import platform_site
	@idp_public {
		path /realms/* /resources/*
		not path /realms/master /realms/master/*
	}
	route {
		abort @direct_tunnel
		abort @from_tenant_pool
		respond @unsafe_path 404
		reverse_proxy @idp_public idp.:8080 {
			import upstream_headers
		}
		respond 404
	}
}

# Listener tunnel-facing: host không có site trên server này (admin.example.com và mọi tên khác edge có chứng
# chỉ) ⇒ đóng kết nối, thay cho phản hồi 200 rỗng mặc định của Caddy khi không site nào khớp.
https://:8443 {
	abort
}

# :80 — /generate_204 trả 204 (kiểm captive portal của client; vang lại challenge như derper), còn lại chuyển
# HTTPS bằng phản hồi nhanh khác 101 (EG-07).
http://, http://:8080 {
	import access_log
	# Vào thẳng listener tunnel-facing mà không qua PROXY header của VPS (địa chỉ đích còn là cổng tunnel)
	# ⇒ đóng kết nối, trước mọi handle khác (proxy_protocol chỉ REJECT nguồn bị deny khi chúng GỬI header).
	@direct_tunnel vars {http.request.local.port} 8443 8080
	handle @direct_tunnel {
		abort
	}
	@gen204 path /generate_204
	@challenge header_regexp X-Tailscale-Challenge ^[A-Za-z0-9._-]{1,64}$
	handle @gen204 {
		header @challenge X-Tailscale-Response "response {http.request.header.X-Tailscale-Challenge}"
		header Cache-Control "no-cache, no-store, must-revalidate, no-transform, max-age=0"
		respond 204
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# Listener admin nội bộ (§14.6): api/worker gọi REST API của ĐÚNG một tenant qua header X-MG-Instance.
# Nguồn ngoài subnet mg-admin ⇒ đóng kết nối; thiếu/sai X-MG-Token ⇒ 403; chỉ /api/v1/* và GET /version;
# token nội bộ và header chọn instance bị gỡ trước khi tới Headscale; API key của instance đi nguyên (Authorization).
http://:8081 {
	bind 10.249.2.2
	import internal_log
	@outside not remote_ip 10.249.2.0/24
	# Hai điều kiện: định dạng (file token đọc lỗi thì placeholder rỗng — header rỗng không được lọt) và giá trị.
	@unauthorized not {
		header_regexp X-MG-Token ^[A-Za-z0-9]{40}$
		header X-MG-Token {file./run/secrets/admin_token}
	}
	@allowed {
		header_regexp instance X-MG-Instance ^([a-z][a-z0-9-]{1,30}[a-z0-9])$
		expression path('/api/v1/*') || (method('GET') && path('/version'))
	}
	@unsafe_path path_regexp unsafe \x5c
	route {
		abort @outside
		respond @unauthorized 403
		respond @unsafe_path 404
		reverse_proxy @allowed hs-{re.instance.1}.:8080 {
			header_up -X-MG-Token
			header_up -X-MG-Instance
		}
		respond 404
	}
	handle_errors 502 503 504 {
		respond 404
	}
}

# Listener metrics nội bộ (§14.6): Prometheus đọc /instance/<slug>/metrics ⇒ hs-<slug>:9090/metrics.
# Không bao giờ proxy /debug/*; token riêng (Authorization: Bearer) bị gỡ trước khi tới Headscale.
http://:9091 {
	bind 10.249.3.2
	import internal_log
	@outside not remote_ip 10.249.3.0/24
	@unauthorized not {
		header_regexp Authorization ^Bearer\s[A-Za-z0-9]{40}$
		header Authorization "Bearer {file./run/secrets/metrics_token}"
	}
	@metrics path_regexp instance ^/instance/([a-z][a-z0-9-]{1,30}[a-z0-9])/metrics$
	route {
		abort @outside
		respond @unauthorized 403
		handle @metrics {
			rewrite * /metrics
			reverse_proxy hs-{re.instance.1}.:9090 {
				header_up -Authorization
			}
		}
		respond 404
	}
	handle_errors 502 503 504 {
		respond 404
	}
}
