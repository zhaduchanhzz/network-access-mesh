# MeshGuard — tham số môi trường KHÔNG chứa secret. Secret luôn ở dạng file (§7.6, §25.1 của plan),
# không bao giờ đặt trong biến môi trường, file compose hay file này.
#
# Mỗi môi trường có MỘT file tham số: infrastructure/environments/<env>/<env>.env (staging: staging.env).
# Mọi tool render, file tham số JSON, template nftables và lệnh trong current.md / RUNBOOK đọc giá trị từ đó qua
# tools/mgenv.py (placeholder ${MG_*}). Muốn đổi VPS, domain hay IP LAN: sửa file của môi trường rồi làm theo
# current.md mục "Luân chuyển". File này chỉ là mẫu đầy đủ các biến; tạo môi trường mới bằng cách sao chép nó thành
# infrastructure/environments/<env>/<env>.env. Ghi đè tạm một biến: đặt biến môi trường cùng tên khi chạy tool.

MG_ENV=example

# Domain gốc của nền tảng (D-1). Các hostname suy ra từ giá trị này:
#   app.<domain>, admin.<domain>, auth.<domain>, <tenant>.mesh.<domain>
# Bản ghi DNS ở chế độ DNS only (không bật proxy của Cloudflare).
MG_BASE_DOMAIN=example.com
MG_DNS_ZONE=example.com

# IPv4 công khai của điểm vào (VPS gateway): DNS *.mesh, derp.server.ipv4 của mọi tenant, /bootstrap-dns, l4proxy
MG_PUBLIC_IPV4=203.0.113.10

# Host trong LAN: edge publish 80/443 trên IP này; dải LAN được tới edge trực tiếp (firewall host)
MG_LAN_IPV4=192.0.2.8
MG_LAN_CIDR=192.0.2.0/24

# Tunnel WireGuard host LAN ↔ VPS và cổng listener tunnel-facing của edge
MG_TUNNEL_HOST_IPV4=10.248.0.2
MG_TUNNEL_VPS_IPV4=10.248.0.1
MG_TUNNEL_PORT=51820
MG_TUNNEL_HTTP_PORT=8080
MG_TUNNEL_HTTPS_PORT=8443

# ACME: "staging" hoặc "production"; tài khoản được CAA cho phép (điền sau lần cấp chứng chỉ đầu tiên)
MG_ACME=staging
MG_ACME_ACCOUNT_URI=https://acme-staging-v02.api.letsencrypt.org/acme/acct/0

# Resolver công khai cho kiểm tra DNS-01; nameserver phát cho client của tenant
MG_DNS_RESOLVERS=1.1.1.1,8.8.8.8
MG_TENANT_NAMESERVERS=1.1.1.1,1.0.0.1

# IdP (P2-T05): identity_providers.id của 3 realm dựng sẵn (platform, tenant-a, tenant-b) — nằm trong redirect URI
# https://<admin|app>.<domain>/api/v1/auth/callback/<id> của client Portal (§8.3). Không phải secret; mỗi môi trường
# sinh bộ mới bằng: python3 tools/render_idp.py new-ids
MG_IDP_ID_PLATFORM=00000000-0000-7000-8000-000000000001
MG_IDP_ID_TENANT_A=00000000-0000-7000-8000-000000000002
MG_IDP_ID_TENANT_B=00000000-0000-7000-8000-000000000003

# Khóa của nền tảng — mỗi môi trường làm nghi thức khóa RIÊNG (P2-T04a; production: P7-T11) theo
# docs/operations/key-ceremony.md, rồi điền hai giá trị CÔNG KHAI dưới đây từ `ceremony.sh status`. Để trống cho tới
# lúc đó (không có giá trị mẫu: một recipient mẫu bị chép nhầm sẽ mã hóa backup tới khóa không ai giữ).
#   MG_BACKUP_RECOVERY_RECIPIENT  recipient age X25519 (age1…, 62 ký tự) của khóa khôi phục backup — đường DR (§17.1)
#   MG_BACKUP_MANIFEST_PUBKEY     khóa công khai Ed25519 kiểm chữ ký manifest backup: SPKI DER base64 một dòng
#                                 (= thân PEM "PUBLIC KEY", bắt đầu MCowBQYDK2VwAyEA); private key chỉ Agent giữ
# Private key (identity khôi phục, khóa ký manifest) và KEK KHÔNG BAO GIỜ nằm trong file tham số.
MG_BACKUP_RECOVERY_RECIPIENT=
MG_BACKUP_MANIFEST_PUBKEY=

# ---------------------------------------------------------------------------------------------------------------------
# Biến của TIẾN TRÌNH api/worker/migrate (P2-T16) — KHÔNG đặt trong file này: tools/render_app.py sinh chúng vào
# compose.app.yaml (project mg-app) từ file tham số này + hằng số thiết kế (IP tĩnh của edge/worker, pool mạng của
# versions.lock). Liệt kê để tra cứu; secret luôn là *_FILE / *_DIR (internal/config từ chối giá trị secret trong env).
#   MG_ENV, MG_LOG_LEVEL, MG_BASE_DOMAIN             môi trường (dev|ci|staging|production), mức log, domain gốc
#   MG_HTTP_ADDR, MG_INTERNAL_ADDR                   listener public (api, sau edge) và nội bộ (/healthz /readyz /metrics)
#   MG_TRUSTED_PROXIES                               api: ĐÚNG IP của edge trên mg-edge (một địa chỉ — ngoài dev cấm dải)
#   MG_DB_URL                                        postgres://postgres:5432/meshguard?sslmode=disable (không user/mật khẩu)
#   MG_DB_TENANT_USER, MG_DB_PLATFORM_USER           role của chính tiến trình (mg_api_* / mg_worker_*)
#   MG_DB_TENANT_PASSWORD_FILE, MG_DB_PLATFORM_PASSWORD_FILE
#   MG_DB_AUDIT_WRITER_PASSWORD_FILE                 api (+ lệnh admin): mg_audit_writer — đường audit detached
#   MG_DB_PARTITION_PASSWORD_FILE                    worker: mg_partition_maint (partition.maintain)
#   MG_KEK_APP_DIR, MG_KEK_OPS_DIR                   keyring kek-app (api, worker), kek-ops (CHỈ worker)
#   MG_EDGE_ADMIN_URL, MG_EDGE_ADMIN_TOKEN_FILE      listener admin của edge trên mg-admin + token của nó
#   MG_EGRESS_DENY_CIDRS                             dải HTTP client IdP phải từ chối (bắt buộc ngoài dev): pool Docker,
#                                                    pool nền tảng/tenant, MG_LAN_CIDR, IP tunnel, MG_PUBLIC_IPV4
#   MG_IDP_PLATFORM_ADDR                             địa chỉ dial của đường hẹp tới auth.<domain> (IP của edge:443)
#   MG_IDP_PROVISIONER_CLIENT_ID                     worker, tùy chọn: client của danh tính provisioning (mặc định mg-provisioner)
#   MG_DB_MIGRATOR_PASSWORD_FILE, MG_DB_ROLE_PASSWORD_DIR      job migrate (mg_migrator + bản mật khẩu từng role)
#   MG_DB_SUPERUSER_PASSWORD_FILE, MG_DB_BACKUP_PASSWORD_FILE  job db-bootstrap (một lần: superuser, mg_backup)
